# Build and test environment, keeps compilers off the host:
#   docker build -t xdp-build:local -f contrib/Dockerfile.build contrib
FROM rust:1-trixie
RUN apt-get update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
       clang llvm libbpf-dev gcc-multilib iproute2 python3 ethtool curl >/dev/null \
    && rm -rf /var/lib/apt/lists/*
